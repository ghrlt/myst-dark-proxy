# myst-relay configuration. Copy to .env and edit.
#
#   cp .env.example .env && $EDITOR .env && make up
#
# Only the two IDENTITY_* settings are mandatory.

# ---------------------------------------------------------------------------
# Identity (required)
# ---------------------------------------------------------------------------
# Absolute path to the Mysterium keystore JSON - the "UTC--<date>--<address>"
# file your Mysterium app wrote, or any export of it. It is mounted read-only;
# this service never modifies it.
MYST_IDENTITY_FILE=/home/you/.mysterium/keystore/UTC--2025-01-01T00-00-00.000000000Z--1234567890abcdef1234567890abcdef12345678

# The relay container runs unprivileged and must be able to read the file
# above. Set these to its owner - `stat -c '%u:%g' "$MYST_IDENTITY_FILE"`.
RELAY_UID=1000
RELAY_GID=1000

# Passphrase that decrypts it. The Mysterium desktop app uses an empty
# passphrase unless you set one, in which case leave this as "".
# To keep it out of the environment entirely, put it in a file and use
# MYST_IDENTITY_PASSPHRASE_FILE=/path/to/file instead (see README).
MYST_IDENTITY_PASSPHRASE=

# ---------------------------------------------------------------------------
# Fixed ports on the host
# ---------------------------------------------------------------------------
# Bind address for all published ports. 127.0.0.1 keeps the relay local;
# use 0.0.0.0 to serve other machines on your LAN (set RELAY_PROXY_USER too).
RELAY_BIND=127.0.0.1

# Numbering: 73 is "myst", the last two digits are the service name, each
# summing its letters with a=0. socks=62, http=60, raw=39, health=48.
RELAY_SOCKS_PORT=7362
RELAY_HTTP_PORT=7360
RELAY_RAW_PORT=7339
RELAY_HEALTH_PORT=7348

# The raw port is a straight pipe to one fixed destination through the exit
# node, for clients that cannot speak a proxy protocol. Leave empty to disable.
#RELAY_RAW_TARGET=example.com:443

# Extra raw forwards, comma separated, for when one is not enough. These are
# container-side listen addresses; publish the matching host ports yourself in
# a compose override.
#RELAY_RAW_FORWARDS=0.0.0.0:7340=192.0.2.10:22,0.0.0.0:7341=example.net:993

# ---------------------------------------------------------------------------
# Access control (optional)
# ---------------------------------------------------------------------------
# Credentials for the SOCKS5 and HTTP frontends. Strongly recommended if
# RELAY_BIND is not 127.0.0.1. Empty means no authentication.
#RELAY_PROXY_USER=relay
#RELAY_PROXY_PASS=change-me

# The control endpoints - change exit, read balance, stop - are off in the
# container. They need a secret to check callers against, and the relay writes
# one beside config.env on a native install; this container's filesystem is
# read-only, so there is nowhere to write it and the endpoints do not exist.
#
# Set a secret here to turn them on. Callers must also come from inside the
# container, so this is for "docker compose exec relay /mystrelay rotate", not
# for reaching in from the host.
#RELAY_CONTROL_TOKEN=a-long-random-string

# ---------------------------------------------------------------------------
# Kill switch
# ---------------------------------------------------------------------------
# strict (true): when the tunnel drops, in-flight streams are torn down as well
# as new ones refused. Set false only if you would rather let downloads finish
# than guarantee no stream outlives its exit node.
RELAY_KILLSWITCH_STRICT=true

# ---------------------------------------------------------------------------
# Sessions and what they cost
# ---------------------------------------------------------------------------
# A Mysterium session is billed per hour as well as per gibibyte, so one that
# nobody is using still spends your balance. Measured against node 1.39.5 on
# 2026-08-22 (0.000445 MYST/hour, 3.56 MYST/GiB network-wide, MYST at $0.11):
# an idle session costs 0.00049 MYST/h - roughly 0.35 MYST a month, about what
# 100 MiB of traffic costs - while building a fresh one costs ~8 KiB and ~12
# seconds, the price of ~3.3 minutes of idling. So a session is worth dropping
# as soon as nothing is using it.

# true: no session until a client connects to a proxy port. The first request
# then waits (~12s) while one is built. false connects at startup instead.
RELAY_ON_DEMAND=true

# Close a session that has carried nothing for this long. 0 keeps it open for
# as long as the relay runs.
RELAY_SESSION_IDLE_TIMEOUT=15m

# How long a client may be made to wait while its session is built. This only
# applies while a session is actually on its way: a tunnel that has failed
# still refuses immediately, so the kill switch stays as quick as ever. Raise
# it if your exit policy makes connecting slow - a provider that establishes a
# session and then cannot carry traffic costs ~30s before another is tried.
#RELAY_ACTIVATION_TIMEOUT=60s

# ---------------------------------------------------------------------------
# Exit node selection
# ---------------------------------------------------------------------------
# Pin one provider (bypasses every filter below):
#EXIT_PROVIDER_ID=0x0000000000000000000000000000000000000000

# Comma-separated allow-lists. Empty means "no constraint".
# The tray ("Change exit node" > "Country of exit") and "mystrelay exit-country"
# move this while the relay runs; a restart returns to what is set here.
#EXIT_COUNTRY=FR,DE
#EXIT_EXCLUDE_PROVIDERS=

# What the exit address looks like to the site on the other end, which is the
# setting that decides whether it is blocked. Hosting exits are the cheapest,
# the fastest and the first thing anything blocks; residential ones pass for a
# person at home and are the majority of the network.
#
#   residential  cellular  business  hosting  content_delivery_network
#   education    government
#
# "cdn" and "datacenter" are accepted for the two long ones. Empty is any kind.
# This is the default: the tray icon's "Change exit node" submenu and
# "mystrelay exit-type <type>" move it while the relay runs, and a restart
# brings it back to whatever is set here.
#EXIT_IP_TYPE=residential

# Mysterium's own quality score, 0..3. Below ~1.0 nodes are usually unusable.
EXIT_MIN_QUALITY=1.5

# Drop candidates slower than this. Empty/0 disables the check.
#EXIT_MAX_LATENCY=400ms

# Reconnect to a different exit on a timer. 0 disables rotation.
#RELAY_ROTATE_EVERY=30m

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
#RELAY_DIAL_TIMEOUT=30s
#RELAY_IDLE_TIMEOUT=0
#RELAY_DNS_MODE=provider

# Fetched once per session through the tunnel to learn the exit address shown
# in /status. Set empty to disable the check and make no outbound request of
# the relay's own.
#RELAY_EXIT_CHECK_URL=https://api.ipify.org
#RELAY_LOG_LEVEL=info
#MYST_LOG_LEVEL=info
#MYST_PROXY_PORT=40000

# ---------------------------------------------------------------------------
# Updating
# ---------------------------------------------------------------------------
# The node image. Left empty it is "latest", which follows upstream: every
# "make update" pulls whatever is newest. Set a version tag instead to pin it,
# and nothing moves until you edit this line - which is the safer setting for a
# relay that must keep behaving as you verified it, since the node's proxy mode
# is undocumented and can change between releases. Upstream publishes version
# tags with an -alpine suffix and no bare number:
#MYST_IMAGE_TAG=1.39.9-alpine
#
# "make update-check" reports what has moved without changing anything.

# Stamped into the relay image and its version string. The relay is built from
# this checkout rather than pulled, so this is only a label - but a useful one
# when more than one build is around.
#RELAY_VERSION=dev
